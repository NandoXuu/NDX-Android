[app]
title = NDX
package.name = ndx
package.domain = org.ndx
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,json,toml,ttf,md,txt,xml
source.include_patterns = assets/*,assets/fonts/*,assets/images/*,plugins/*
source.exclude_dirs = tests,bin,.buildozer,docs,tools,projects,cache,data,logs,environments,__pycache__,.git,assets/android
version = 1.0.0

# Only what the implemented modules import. Pillow/Pygments/psutil need p4a recipes (they exist);
# requests is NOT used (urllib + certifi). Verify each on your p4a version: see docs/BUILD.md.
# MUST equal requirements/android.txt (checked by tests/test_build_config.py). KivyMD stays at 1.2.0.
requirements = python3==3.11.5,hostpython3==3.11.5,kivy==2.3.0,kivymd==1.2.0,pillow,pygments,pyjnius,plyer,packaging,certifi,psutil

orientation = portrait,landscape
fullscreen = 0

# --- Visual resources -------------------------------------------------------
presplash.filename = %(source.dir)s/assets/splash/presplash.png
presplash.color = #0D1117
icon.filename = %(source.dir)s/assets/icon/icon_legacy.png
icon.adaptive_foreground.filename = %(source.dir)s/assets/icon/icon_foreground.png
icon.adaptive_background.filename = %(source.dir)s/assets/icon/icon_background.png

# --- Android ----------------------------------------------------------------
android.api = 33
android.minapi = 24
android.ndk = 25b
android.archs = arm64-v8a, armeabi-v7a
android.allow_backup = False
android.extra_manifest_xml = ./android/extra_manifest.xml
android.enable_androidx = True
android.accept_sdk_license = True
android.window_title = NDX
android.debug_artifact = apk
android.release_artifact = apk
android.logcat_filters = *:S python:D

# Only permissions used by implemented modules (see docs/PERMISSIONS.md).
# com.termux.permission.RUN_COMMAND is declared so the OPTIONAL Termux integration can ask; it is a dangerous
# permission the user must grant, and Termux must set allow-external-apps=true (docs/TERMUX.md).
# Package visibility for the optional Termux integration is declared in android/extra_manifest.xml.
# Target api 33: no FOREGROUND_SERVICE_<TYPE> permission is required. Raising android.api to 34+ requires a
# foreground service type (e.g. dataSync/specialUse) plus its permission - see docs/BACKGROUND.md. Unverified.
android.permissions = INTERNET,ACCESS_NETWORK_STATE,FOREGROUND_SERVICE,POST_NOTIFICATIONS,WAKE_LOCK,com.termux.permission.RUN_COMMAND

# Density-specific launcher icons (mipmap-*), drawables and values are merged into res/.
# This line is generated by tools/generate_assets.py - do not edit by hand.
android.add_resources = %(source.dir)s/assets/android/res/drawable/ndx_logo_vector.xml:drawable/ndx_logo_vector.xml,%(source.dir)s/assets/android/res/drawable-hdpi/ic_stat_ndx.png:drawable-hdpi/ic_stat_ndx.png,%(source.dir)s/assets/android/res/drawable-mdpi/ic_stat_ndx.png:drawable-mdpi/ic_stat_ndx.png,%(source.dir)s/assets/android/res/drawable-nodpi/ndx_empty_projects.png:drawable-nodpi/ndx_empty_projects.png,%(source.dir)s/assets/android/res/drawable-nodpi/ndx_empty_terminal.png:drawable-nodpi/ndx_empty_terminal.png,%(source.dir)s/assets/android/res/drawable-nodpi/ndx_splash.png:drawable-nodpi/ndx_splash.png,%(source.dir)s/assets/android/res/drawable-xhdpi/ic_stat_ndx.png:drawable-xhdpi/ic_stat_ndx.png,%(source.dir)s/assets/android/res/drawable-xxhdpi/ic_stat_ndx.png:drawable-xxhdpi/ic_stat_ndx.png,%(source.dir)s/assets/android/res/drawable-xxxhdpi/ic_stat_ndx.png:drawable-xxxhdpi/ic_stat_ndx.png,%(source.dir)s/assets/android/res/mipmap-anydpi-v26/ndx_launcher.xml:mipmap-anydpi-v26/ndx_launcher.xml,%(source.dir)s/assets/android/res/mipmap-hdpi/icon.png:mipmap-hdpi/icon.png,%(source.dir)s/assets/android/res/mipmap-hdpi/icon_round.png:mipmap-hdpi/icon_round.png,%(source.dir)s/assets/android/res/mipmap-hdpi/ndx_ic_foreground.png:mipmap-hdpi/ndx_ic_foreground.png,%(source.dir)s/assets/android/res/mipmap-hdpi/ndx_ic_monochrome.png:mipmap-hdpi/ndx_ic_monochrome.png,%(source.dir)s/assets/android/res/mipmap-mdpi/icon.png:mipmap-mdpi/icon.png,%(source.dir)s/assets/android/res/mipmap-mdpi/icon_round.png:mipmap-mdpi/icon_round.png,%(source.dir)s/assets/android/res/mipmap-mdpi/ndx_ic_foreground.png:mipmap-mdpi/ndx_ic_foreground.png,%(source.dir)s/assets/android/res/mipmap-mdpi/ndx_ic_monochrome.png:mipmap-mdpi/ndx_ic_monochrome.png,%(source.dir)s/assets/android/res/mipmap-xhdpi/icon.png:mipmap-xhdpi/icon.png,%(source.dir)s/assets/android/res/mipmap-xhdpi/icon_round.png:mipmap-xhdpi/icon_round.png,%(source.dir)s/assets/android/res/mipmap-xhdpi/ndx_ic_foreground.png:mipmap-xhdpi/ndx_ic_foreground.png,%(source.dir)s/assets/android/res/mipmap-xhdpi/ndx_ic_monochrome.png:mipmap-xhdpi/ndx_ic_monochrome.png,%(source.dir)s/assets/android/res/mipmap-xxhdpi/icon.png:mipmap-xxhdpi/icon.png,%(source.dir)s/assets/android/res/mipmap-xxhdpi/icon_round.png:mipmap-xxhdpi/icon_round.png,%(source.dir)s/assets/android/res/mipmap-xxhdpi/ndx_ic_foreground.png:mipmap-xxhdpi/ndx_ic_foreground.png,%(source.dir)s/assets/android/res/mipmap-xxhdpi/ndx_ic_monochrome.png:mipmap-xxhdpi/ndx_ic_monochrome.png,%(source.dir)s/assets/android/res/mipmap-xxxhdpi/icon.png:mipmap-xxxhdpi/icon.png,%(source.dir)s/assets/android/res/mipmap-xxxhdpi/icon_round.png:mipmap-xxxhdpi/icon_round.png,%(source.dir)s/assets/android/res/mipmap-xxxhdpi/ndx_ic_foreground.png:mipmap-xxxhdpi/ndx_ic_foreground.png,%(source.dir)s/assets/android/res/mipmap-xxxhdpi/ndx_ic_monochrome.png:mipmap-xxxhdpi/ndx_ic_monochrome.png,%(source.dir)s/assets/android/res/values/ndx_colors.xml:values/ndx_colors.xml,%(source.dir)s/assets/android/res/values/ndx_dimens.xml:values/ndx_dimens.xml,%(source.dir)s/assets/android/res/values-night/ndx_colors.xml:values-night/ndx_colors.xml

# Foreground supervisor service (service/main.py, docs/BACKGROUND.md). Reduces, never removes, the chance Android stops NDX.
services = ndxkeepalive:service/main.py:foreground:sticky

[buildozer]
log_level = 2
warn_on_root = 1
